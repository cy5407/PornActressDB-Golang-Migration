[database]
json_data_dir = data/json_db
; database_path =  # 舊版 SQLite 路徑（已不使用）

[paths]
; 請修改為你本機的下載目錄
default_input_dir = C:/Users/YOUR_USERNAME/Downloads

[search]
batch_size = 10
thread_count = 5
batch_delay = 2.0
request_timeout = 20
avwiki_concurrent_enabled = true
avwiki_max_concurrent = 15

[classification]
mode = interactive
auto_apply_preferences = true

[cache]
ttl_days = 7
max_size_mb = 500
auto_cleanup_on_exit = true

[go_integration]
enabled = true
; exe_path =  # 留空則自動搜尋 classifier.exe
scan_workers = 10
move_conflict_strategy = skip
enable_operation_log = true
log_dir = logs
